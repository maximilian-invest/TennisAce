# https://editorconfig.org — shared formatting baseline for both platforms
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Kotlin / Gradle
[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# Swift
[*.swift]
indent_size = 4

# Markup / config
[*.{yml,yaml,json,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
