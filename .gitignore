# ── Monorepo root ───────────────────────────────────────────────
# Platform-specific ignores live in ios/.gitignore and android/.gitignore.
# This file only covers things that can appear anywhere.

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Editors / IDEs
.idea/
*.iml
.vscode/
*.swp
*~

# Env / secrets — never commit credentials
.env
.env.*
!.env.example
*.local

# Logs
*.log
