# Supabase — Phase 5 (Cloud Auth & Sync)
#
# These EXPO_PUBLIC_* values are inlined into the client bundle at build time.
# The anon key is a *publishable* key and is safe to ship in the app — never put
# the service_role/secret key here.
#
# Copy this file to `.env` and fill in the anon key from:
#   Supabase Dashboard → Project (tennisace) → Settings → API → Project API keys.

EXPO_PUBLIC_SUPABASE_URL=https://wrhbdnhlndoxynzbhicj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
