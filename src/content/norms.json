{
  "_meta": {
    "title": "ACE Athlete – Normwerte für Scoring-Engine",
    "version": "1.0",
    "description": "Referenzwerte je Test, Geschlecht und Altersband. Wird vom scoringEngine genutzt (Abschnitt 3 der Functional Spec). Zwei Methoden: 'meanSd' -> Punkte = clamp(50 + 16.7*z, 0, 100), z = (wert-mean)/sd; bei direction='lowerBetter' z negieren. 'ratingBands' -> Rohwert in Band einordnen, Band -> points.",
    "ratingToPoints": { "poor": 10, "belowAverage": 30, "average": 50, "aboveAverage": 65, "veryGood": 82, "elite": 100 },
    "ageBands": ["10-11", "12-13", "14-15", "16-17", "18-29", "30-39", "40-49", "50plus"],
    "sexes": ["m", "w"],
    "confidenceLegend": {
      "high": "tennis-spezifisch belegt (Jugend-Meta-Analyse / Studien)",
      "medium": "allgemeine Sport-/Fitnessnorm (nicht tennis-spezifisch)",
      "estimate": "interpoliert/abgeleitet – vor Launch idealerweise härten"
    },
    "hardeningTip": "Beste Quelle zum Härten der Jugendwerte: Axman et al. 2025, Systematic Review 8008 Jugend-Tennisspieler (PMC12397999) – enthält volle Perzentiltabellen für 20m-Sprint, CMJ, Spider, Hexagon, Grip, Med-Ball nach U12/U14/U16 × Geschlecht.",
